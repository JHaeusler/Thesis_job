# ----------------- grafico convencional de dos puntos --------####
library(pBrackets)
library(AcceptanceSampling)
alpha <- 0.05
beta <- 0.10
AQL <- 0.05
LTPD <- 0.10
plan <- find.plan(PRP = c(AQL, 1 - alpha), CRP = c(LTPD, beta),
N = N, type = "hypergeom")
n_kir <- plan$n
c_kir <- plan$c
