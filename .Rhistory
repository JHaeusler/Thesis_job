poblacion <- rnorm(10000, mu, sigma)
n <- 10 # parámetro m binomial
p <- 0.5 # parámetro p de la binomial
k <- 100 # numero de elementos generados por vector
mu <- 0.66 # parámetro promedio para dist normal
sigma <- 0.005244 # parámetro sigma para dist normal
runif(k)
rnorm(k)
rbinom(k, n, p)
m <- 200 # número de muestras distintas entre todas las posibles muestras
prome_muest <- numeric(m)
for(i in 1:m){ # i <- 1 + i
muestra <- rnorm(k, mu, sigma)
prome_muest[i] <- mean(muestra)
}
sigma/sqrt(k)
sd(prome_muest)
qqnorm(prome_muest)
qqline(prome_muest)
shapiro.test(prome_muest)
# Método Bootstrap
