# AJUSTE 1: Nuevo identificador del dataset (extraído de la URL)
dataset_slug <- "shaistashahid/freelancer-income-vs-skills"

# Construir la URL de descarga de la API
url <- paste0("https://www.kaggle.com/api/v1/datasets/download/", dataset_slug)

# Realizar la petición segura
respuesta <- GET(url, authenticate(kaggle_user, kaggle_key, type = "basic"))

# Verificar si la descarga fue exitosa
if (status_code(respuesta) == 200) {
  temp <- tempfile(fileext = ".zip")
  writeBin(content(respuesta, "raw"), temp)
  
  archivos_en_zip <- unzip(temp, list = TRUE)
  # Se lee el primer archivo CSV contenido en el ZIP de freelancers
  datos_freelancer <- read.csv(unzip(temp, archivos_en_zip$Name[1]))
  
  message("¡Éxito! Dataset de Freelancers cargado correctamente.")
} else {
  stop("Error en la descarga. Revisa tus credenciales o el slug del dataset.")
}

